+function validateMediaDate(value: unknown, env: Env): Response | null {
+  if (value === null) return null;
+  const invalid = () => badRequest('media_date must be null or a real YYYY-MM-DD date no later than today in the shop timezone.', env);
+  if (typeof value !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(value) || value.startsWith('0000-')) return invalid();
+  const date = new Date(`${value}T00:00:00.000Z`);
+  if (!Number.isFinite(date.getTime()) || date.toISOString().slice(0, 10) !== value) return invalid();
+
+  // Only the server clock and operator-configured Shopify timezone define today.
+  let parts: Intl.DateTimeFormatPart[];
+  try {
+    if (!env.SHOP_TIMEZONE) throw new Error('Missing timezone');
+    parts = new Intl.DateTimeFormat('en-US', {
+      timeZone: env.SHOP_TIMEZONE, calendar: 'gregory', numberingSystem: 'latn',
+      year: 'numeric', month: '2-digit', day: '2-digit',
+    }).formatToParts(new Date());
+  } catch {
+    return json({ error: 'SHOP_TIMEZONE must be configured with the Shopify shop timezone.' }, { status: 500 }, env);
+  }
+  const today = ['year', 'month', 'day'].map((type) => parts.find((part) => part.type === type)!.value).join('-');
+  return value > today ? invalid() : null;
+}
